# Credenciales de API de Mozilla Add-ons (AMO)
# Consíguelas en: https://addons.mozilla.org/es/developers/addon/api/key/
AMO_JWT_ISSUER=user:12345678:123
AMO_JWT_SECRET=tu_secreto_hexadecimal_aqui

# Configuración de Android (Opcional, se auto-detecta si hay un solo dispositivo)
# ANDROID_DEVICE_ID=
# FIREFOX_APK=org.mozilla.firefox
# Valores comunes para FIREFOX_APK:
# - org.mozilla.firefox (Firefox Release)
# - org.mozilla.firefox_beta (Firefox Beta)
# - org.mozilla.fenix.nightly (Firefox Nightly)
# - org.mozilla.fenix (Firefox / Fenix)
